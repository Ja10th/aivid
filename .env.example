DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Cloudflare R2, Amazon S3, or another S3-compatible provider (optional).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=aiv2-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Cloudinary. When configured, Cloudinary takes priority over S3/R2.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Worker polling interval. Use this only on the worker service.
WORKER_INTERVAL_MS=5000

# YouTube OAuth, if posting is enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=